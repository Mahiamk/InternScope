{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend", "path": "/api/$1" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "backend", "path": "/uploads/$1" }
    },
    {
      "source": "/docs",
      "destination": { "service": "backend", "path": "/docs" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "backend", "path": "/openapi.json" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "frontend", "path": "/assets/$1" }
    },
    {
      "source": "/(.*\\.[a-zA-Z0-9]+)",
      "destination": { "service": "frontend", "path": "/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    }
  ]
}
