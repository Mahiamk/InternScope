{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend", "path": "/api/$1" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "backend", "path": "/uploads/$1" }
    },
    {
      "source": "/docs",
      "destination": { "service": "backend", "path": "/docs" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "backend", "path": "/openapi.json" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
