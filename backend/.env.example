# Project Configuration
PROJECT_NAME="InternScope API"
VERSION="1.0.0"

# Database Configuration
# For local dev / testing:
DATABASE_URL="sqlite+aiosqlite:///./internscope.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/internscope"

# JWT Secret & Security
SECRET_KEY="replace-this-with-a-secure-random-secret-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Uploads
UPLOAD_DIR="uploads"
MAX_IMAGE_SIZE_BYTES=5242880

# Google Gemini AI API Key for CV Analyser
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
